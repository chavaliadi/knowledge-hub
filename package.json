{
  "name": "project",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:client": "bun --cwd packages/client dev",
    "dev:server": "bun --cwd packages/server dev",
    "dev": "bun run dev:server & bun run dev:client",
    "typecheck": "bun --cwd packages/client tsc --noEmit && bun --cwd packages/server tsc --noEmit",
    "verify:migrations": "bun --cwd packages/server verify:migrations",
    "test:duplicate": "bun --cwd packages/server test:duplicate",
    "test:failover": "bun --cwd packages/server test:failover",
    "test:reindex": "bun --cwd packages/server test:reindex",
    "test:attachments": "bun --cwd packages/server test:attachments",
    "test:health": "bun --cwd packages/server test:health",
    "test:clipper": "bun --cwd packages/server test:clipper",
    "test:rls": "bun --cwd packages/server test:rls",
    "test:ingestion": "bun --cwd packages/server test:ingestion"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "workspaces": [
    "packages/client",
    "packages/server"
  ]
}
