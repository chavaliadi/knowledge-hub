{
  "manifest_version": 3,
  "name": "KnowledgeHub Clipper",
  "version": "1.0.0",
  "description": "Clip articles, snippets, bookmarks, and developer resources directly into your KnowledgeHub.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
